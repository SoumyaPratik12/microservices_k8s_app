{
  "name": "microservices-k8s-app",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  "forwardPorts": [8000, 8001, 8002, 8003, 8004],
  "portsAttributes": {
    "8000": { "label": "API Gateway", "onAutoForward": "notify" },
    "8001": { "label": "Auth Service", "onAutoForward": "silent" },
    "8002": { "label": "Product Service", "onAutoForward": "silent" },
    "8003": { "label": "Payment Service", "onAutoForward": "silent" },
    "8004": { "label": "Order Service", "onAutoForward": "silent" }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-azuretools.vscode-docker"]
    }
  }
}
